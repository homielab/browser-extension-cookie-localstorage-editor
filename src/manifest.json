{
  "manifest_version": 3,
  "name": "Cookie & LocalStorage Editor by HomieLab",
  "version": "1.0.0",
  "homepage_url": "https://homielab.com",
  "description": "Quick edit cookies and localStorage of the current site: view, add, delete, import and export as JSON. No tracking.",

  "minimum_chrome_version": "119",

  "permissions": ["cookies", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],

  "action": {
    "default_title": "Cookie & LocalStorage Editor by HomieLab",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-editor@homielab.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
